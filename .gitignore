# Data — Kaggle competition rules permit academic/educational/non-commercial use
# but prohibit redistributing the raw files, so these must never be committed.
data/raw/
data/**/*.csv
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
*.zip
*.parquet

# DuckDB
*.duckdb
*.duckdb.wal
*.db

# Power BI — .pbix embeds a full copy of the imported data in its internal model,
# same Kaggle redistribution concern as the CSVs it's built from. Binary and not
# diff-friendly in git either way, so it stays local-only.
dashboards/*.pbix
dashboards/*.pbit
!dashboards/.gitkeep

# Secrets
.env
kaggle.json
.kaggle/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/
.ruff_cache/

# Reports output
reports/*.html
reports/*.pdf
!reports/.gitkeep

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
