# Data — never commit raw or processed credit data
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
*.csv
*.zip
*.parquet

# DuckDB
*.duckdb
*.duckdb.wal
*.db

# Secrets
.env
kaggle.json
.kaggle/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/
.ruff_cache/

# Reports output
reports/*.html
reports/*.pdf
!reports/.gitkeep

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
